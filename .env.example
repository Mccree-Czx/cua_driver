# 应用级环境变量（复制为 .env 生效）——全部为本地开发占位值，无真实密钥

# ── 数据底座 ──
DATABASE_URL=mysql+pymysql://hr_user:hr_dev_pw@127.0.0.1:3306/hr_workbuddy
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── CUA 驱动 ──
CUA_DRIVER_MODE=mock

# ── 真实模式节奏闸（风控防线；连续高频操作会触发平台安全验证）──
# 任务间隔（秒）：每个任务结束后的冷却；真实模式默认 30（E2E instant 自动置 0）
CUA_TASK_GAP_SECONDS=30
# 失败重试延后（秒）：禁止 0 秒快速连重试；真实模式默认 60（E2E instant 自动置 0）
CUA_RETRY_DEFER_SECONDS=60

# ── 调度窗口与限频 ──
WORK_WINDOW_START=08:00
WORK_WINDOW_END=22:00
MSG_RATE_PER_HOUR=30
DAILY_MSG_CAP=420
# ── 筛选 ──
LLM_DEFAULT_THRESHOLD=70
RESUME_TIMEOUT_HOURS=72

# ── 筛选 LLM（OpenAI 兼容） ──
SCREENING_LLM_BASE_URL=http://127.0.0.1:11434/v1
SCREENING_LLM_API_KEY=dev-placeholder-key
SCREENING_LLM_MODEL=dev-model

# ── CUA 大脑 LLM（OpenAI 兼容） ──
CUA_BRAIN_BASE_URL=http://127.0.0.1:11434/v1
CUA_BRAIN_API_KEY=dev-placeholder-key
CUA_BRAIN_MODEL=dev-model

# ── 账号密码加密主密钥（Fernet） ──
# 只放本文件，绝不入库、不进 git。留空则「账号密码」功能不可用
# （登录核验等不依赖它的功能不受影响）。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 只有 pipeline 所在的机器需要它。Mac 侧目前走验证码登录、不解密任何东西，
# 等启用「密码登录」时再同步过去（届时两处必须是同一个密钥）。
# 密钥丢失 = 已存的密码不可恢复（账号本身不受影响，重填即可）。
ACCOUNT_SECRET_KEY=
